{
  "name": "desk-foreman-frontend",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:spec": "RUSTC_WRAPPER= cargo run --manifest-path ../Cargo.toml --bin export-openapi openapi.json",
    "gen:client": "openapi-ts",
    "gen:api": "bun run gen:spec && bun run gen:client"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.19",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
