{
  "name": "desk-foreman-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:spec": "RUSTC_WRAPPER= cargo run --manifest-path ../Cargo.toml --bin export-openapi openapi.json",
    "gen:client": "openapi-ts",
    "gen:api": "bun run gen:spec && bun run gen:client"
  },
  "dependencies": {
    "@nuxt/ui": "^3.3.7",
    "@vitejs/plugin-vue": "^6.0.2",
    "tailwindcss": "^4.1.17",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.97.1",
    "@types/node": "^24.10.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.2.7",
    "vue-tsc": "^3.1.8"
  }
}
