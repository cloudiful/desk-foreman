{
  "db_name": "PostgreSQL",
  "query": "-- Claim the oldest pending Git job assigned to one manager, using DB time.\n-- SKIP LOCKED makes concurrent polls race for a single winner; expired rows\n-- are never claimable and no claimed/uncertain row is re-claimed.\nUPDATE workspace_git_jobs\nSET state = 'claimed',\n    claimed_at = NOW(),\n    updated_at = NOW()\nWHERE job_id = (\n    SELECT job_id\n    FROM workspace_git_jobs\n    WHERE assigned_manager_id = $1\n      AND state = 'pending'\n      AND deadline_at > NOW()\n    ORDER BY created_at ASC, job_id ASC\n    FOR UPDATE SKIP LOCKED\n    LIMIT 1\n)\nRETURNING\n    job_id,\n    token,\n    operation_id,\n    application_id,\n    workspace_binding_id,\n    assigned_manager_id,\n    code_project_id,\n    authorization_generation,\n    job_kind,\n    state,\n    canonical_branch,\n    expected_base,\n    principal_digest,\n    lease_owner,\n    lease_acquired_at,\n    reserved_bytes,\n    cleanup_confirmed,\n    claimed_at,\n    deadline_at,\n    terminal_at,\n    result,\n    error_summary,\n    created_at,\n    updated_at;\n",
