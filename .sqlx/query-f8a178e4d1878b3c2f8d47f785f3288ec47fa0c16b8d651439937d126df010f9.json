{
  "db_name": "PostgreSQL",
  "query": "-- Insert one durable operation intent for an already-bound environment\n-- (issue 742 P3). The caller holds the owner-scoped environment row lock, so\n-- `ON CONFLICT (token) DO NOTHING` only reconciles a same-token replay.\nINSERT INTO execution_environment_jobs (\n    job_id,\n    token,\n    environment_id,\n    application_id,\n    assigned_manager_id,\n    job_kind,\n    target_generation,\n    deadline_at\n) VALUES ($1, $2, $3, $4, $5, $6, $7, $8)\nON CONFLICT (token) DO NOTHING\nRETURNING\n    job_id,\n    token,\n    environment_id,\n    application_id,\n    assigned_manager_id,\n    job_kind,\n    target_generation,\n    state,\n    claimed_at,\n    deadline_at,\n    terminal_at,\n    result,\n    error_summary,\n    created_at,\n    updated_at;\n",
