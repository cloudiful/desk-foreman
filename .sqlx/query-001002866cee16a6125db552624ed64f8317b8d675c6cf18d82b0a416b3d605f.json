  "db_name": "PostgreSQL",
  "query": "UPDATE execution_environments\nSET\n    generation = generation + 1,\n    state = 'stopping',\n    last_active_at = NOW(),\n    updated_at = NOW()\nWHERE environment_id = $1\n  AND application_id = $2\n  AND generation = $3\nRETURNING\n    environment_id,\n    application_id,\n    external_user_id,\n    runtime_kind,\n    generation,\n    state,\n    state_volume_ref,\n    last_active_at,\n    created_at,\n    updated_at;\n",
