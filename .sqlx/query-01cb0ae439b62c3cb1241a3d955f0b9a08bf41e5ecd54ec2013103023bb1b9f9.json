{
  "db_name": "PostgreSQL",
  "query": "-- Owner-scoped environment row lock for one task admission/cancel/release\n-- (issue 753 P1). The caller holds this lock through the whole transaction, so\n-- the active-task anchor and the task row cannot move underneath it.\nSELECT\n    environment_id,\n    application_id,\n    external_user_id,\n    generation,\n    state,\n    assigned_manager_id,\n    container_generation,\n    stop_proof_job_id,\n    stop_proof_generation,\n    active_native_task_id\nFROM execution_environments\nWHERE environment_id = $1\n  AND application_id = $2\nFOR UPDATE;\n",
