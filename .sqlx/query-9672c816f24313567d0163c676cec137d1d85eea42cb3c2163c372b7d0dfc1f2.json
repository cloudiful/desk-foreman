{
  "db_name": "PostgreSQL",
  "query": "-- Claim the oldest pending durable environment job assigned to one manager\n-- (issue 742 P2). `FOR UPDATE SKIP LOCKED` makes concurrent polls race for a\n-- single winner; expired and non-pending rows are never claimable.\nUPDATE execution_environment_jobs\nSET state = 'claimed',\n    claimed_at = NOW(),\n    updated_at = NOW()\nWHERE job_id = (\n    SELECT job_id\n    FROM execution_environment_jobs\n    WHERE assigned_manager_id = $1\n      AND state = 'pending'\n      AND deadline_at > NOW()\n    ORDER BY created_at ASC, job_id ASC\n    FOR UPDATE SKIP LOCKED\n    LIMIT 1\n)\nRETURNING\n    job_id,\n    token,\n    environment_id,\n    application_id,\n    assigned_manager_id,\n    job_kind,\n    target_generation,\n    state,\n    claimed_at,\n    deadline_at,\n    terminal_at,\n    result,\n    error_summary,\n    created_at,\n    updated_at;\n",
