  "query": "-- One durable operation row by opaque replay token within one owned\n-- environment (issue 742 P3).\nSELECT\n    job_id,\n    token,\n    environment_id,\n    application_id,\n    assigned_manager_id,\n    job_kind,\n    target_generation,\n    state,\n    claimed_at,\n    deadline_at,\n    terminal_at,\n    result,\n    error_summary,\n    created_at,\n    updated_at\nFROM execution_environment_jobs\nWHERE application_id = $1\n  AND environment_id = $2\n  AND token = $3\nLIMIT 1;\n",
