{
  "db_name": "PostgreSQL",
  "query": "-- Recovery stop while already stopping/uncertain with the same candidate: set\n-- state `stopping` without another generation increment and without any\n-- candidate change or manager reassignment (issue 742 P3).\nUPDATE execution_environments\nSET state = 'stopping',\n    last_active_at = NOW(),\n    updated_at = NOW()\nWHERE environment_id = $1\n  AND application_id = $2\n  AND generation = $3\nRETURNING\n    environment_id,\n    application_id,\n    external_user_id,\n    runtime_kind,\n    generation,\n    state,\n    state_volume_ref,\n    assigned_manager_id,\n    container_generation,\n    stop_proof_job_id,\n    stop_proof_generation,\n    last_active_at,\n    created_at,\n    updated_at;\n",
