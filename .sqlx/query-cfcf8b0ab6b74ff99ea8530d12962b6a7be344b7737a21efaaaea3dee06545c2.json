{
  "db_name": "PostgreSQL",
  "query": "-- Lock one preparation job after its environment, task and binding have been\n-- locked. The clock check is evaluated after those potentially waiting locks.\nSELECT\n    job_id,\n    native_task_id,\n    assigned_manager_id,\n    job_kind,\n    target_generation,\n    state,\n    deadline_at > clock_timestamp() AS deadline_valid\nFROM execution_environment_jobs\nWHERE job_id = $1\n  AND application_id = $2\n  AND environment_id = $3\nFOR UPDATE;\n",
