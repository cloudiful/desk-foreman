{
  "db_name": "PostgreSQL",
  "query": "-- Trusted manager-only lookup of one durable environment job by its stable\n-- UUID (issue 742 P2). Not a client store: only the authenticated\n-- runner-manager result path calls this, and it re-verifies the assigned\n-- manager against the row before any evaluation.\nSELECT\n    job_id,\n    token,\n    environment_id,\n    application_id,\n    assigned_manager_id,\n    job_kind,\n    target_generation,\n    native_task_id,\n    state,\n    claimed_at,\n    deadline_at,\n    terminal_at,\n    result,\n    error_summary,\n    created_at,\n    updated_at\nFROM execution_environment_jobs\nWHERE job_id = $1\nLIMIT 1;\n",
