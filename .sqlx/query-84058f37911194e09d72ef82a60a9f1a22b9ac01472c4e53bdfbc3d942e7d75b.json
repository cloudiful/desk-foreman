{
  "db_name": "PostgreSQL",
  "query": "-- Mark a task uncertain when a cancel cannot prove nothing was dispatched\n-- (issue 753 P1).\n--\n-- Uncertainty is sticky and terminal-forever for admission purposes: both\n-- active indexes keep counting this row, so it still blocks a new task on this\n-- environment and binding until an operator resolves it.\nUPDATE execution_environment_tasks\nSET state = 'uncertain',\n    updated_at = NOW()\nWHERE task_id = $1\n  AND application_id = $2\n  AND environment_id = $3\n  AND state <> 'released'\nRETURNING\n    task_id,\n    operation_token,\n    environment_id,\n    application_id,\n    workspace_binding_id,\n    subject_external_user_id,\n    target_generation,\n    assigned_manager_id,\n    state,\n    container_generation,\n    prepare_job_id,\n    created_at,\n    updated_at,\n    terminal_at;\n",
