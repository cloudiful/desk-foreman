{
  "db_name": "PostgreSQL",
  "query": "-- Owner-scoped replay lookup by opaque operation token (issue 753 P1).\n--\n-- Scoped to the owning application so a foreign token is simply absent: a\n-- caller can never learn that another application's task exists.\nSELECT\n    task_id,\n    operation_token,\n    environment_id,\n    application_id,\n    workspace_binding_id,\n    subject_external_user_id,\n    target_generation,\n    assigned_manager_id,\n    state,\n    container_generation,\n    prepare_job_id,\n    created_at,\n    updated_at,\n    terminal_at\nFROM execution_environment_tasks\nWHERE operation_token = $1\n  AND application_id = $2;\n",
