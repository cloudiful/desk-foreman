{
  "db_name": "PostgreSQL",
  "query": "-- Mark a task `prepared` once its original manager proved materialization\n-- (issue 753 P2b).\n--\n-- Guarded on the task still being `preparing` and still linked to this exact\n-- preparation job, so a late ack after a cancel can never re-mark a task\n-- terminal or prepared.\nUPDATE execution_environment_tasks\nSET state = 'prepared',\n    updated_at = NOW()\nWHERE task_id = $1\n  AND application_id = $2\n  AND environment_id = $3\n  AND state = 'preparing'\n  AND prepare_job_id = $4\nRETURNING\n    task_id,\n    operation_token,\n    environment_id,\n    application_id,\n    workspace_binding_id,\n    subject_external_user_id,\n    target_generation,\n    assigned_manager_id,\n    state,\n    container_generation,\n    prepare_job_id,\n    created_at,\n    updated_at,\n    terminal_at;\n",
