{
  "db_name": "PostgreSQL",
  "query": "-- Insert one original-manager native task execution job.\nINSERT INTO execution_environment_jobs (\n    job_id,\n    token,\n    environment_id,\n    application_id,\n    assigned_manager_id,\n    job_kind,\n    target_generation,\n    admission_generation,\n    native_task_id,\n    deadline_at\n)\nSELECT\n    $1,\n    $2,\n    env.environment_id,\n    env.application_id,\n    $5,\n    $6,\n    $7,\n    $11,\n    $8,\n    $9\nFROM execution_environments AS env\nJOIN runner_managers AS mgr\n    ON mgr.runner_manager_id = $5\n   AND mgr.enabled = TRUE\n   AND mgr.status = 'online'\n   AND mgr.last_seen_at > NOW() - ($10::double precision * INTERVAL '1 second')\nJOIN execution_environment_tasks AS task\n    ON task.task_id = $8\n   AND task.environment_id = env.environment_id\n   AND task.application_id = env.application_id\nWHERE env.environment_id = $3\n  AND env.application_id = $4\nON CONFLICT DO NOTHING\nRETURNING\n    job_id,\n    token,\n    environment_id,\n    application_id,\n    assigned_manager_id,\n    job_kind,\n    target_generation,\n    admission_generation,\n    native_task_id,\n    state,\n    claimed_at,\n    deadline_at,\n    terminal_at,\n    result,\n    error_summary,\n    created_at,\n    updated_at;\n",
