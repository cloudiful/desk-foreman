{
  "db_name": "PostgreSQL",
  "query": "-- Fail closed: overdue pending/claimed jobs of one owned environment become\n-- `uncertain` before any lifecycle state decision (issue 742 P3). Expiry never\n-- marks a container ready or stopped; it only retains the blocker.\nUPDATE execution_environment_jobs\nSET state = 'uncertain',\n    terminal_at = NOW(),\n    updated_at = NOW()\nWHERE application_id = $1\n  AND environment_id = $2\n  AND state IN ('pending', 'claimed')\n  AND deadline_at <= NOW()\nRETURNING\n    job_id,\n    token,\n    environment_id,\n    application_id,\n    assigned_manager_id,\n    job_kind,\n    target_generation,\n    native_task_id,\n    state,\n    claimed_at,\n    deadline_at,\n    terminal_at,\n    result,\n    error_summary,\n    created_at,\n    updated_at;\n",
