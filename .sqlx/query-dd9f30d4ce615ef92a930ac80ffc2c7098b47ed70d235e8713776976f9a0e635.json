{
  "db_name": "PostgreSQL",
  "query": "-- Compare-and-set completion by the assigned manager and token.\n-- Success/failed require confirmed cleanup and become terminal; uncertain\n-- retains the reservation with no terminal timestamp.\nUPDATE workspace_git_jobs\nSET state = $4,\n    result = $5,\n    error_summary = $6,\n    cleanup_confirmed = $7,\n    terminal_at = CASE WHEN $4 = 'uncertain' THEN NULL ELSE NOW() END,\n    updated_at = NOW()\nWHERE job_id = $1\n  AND token = $2\n  AND assigned_manager_id = $3\n  AND state = 'claimed'\n  AND deadline_at > NOW()\nRETURNING\n    job_id,\n    token,\n    operation_id,\n    application_id,\n    workspace_binding_id,\n    assigned_manager_id,\n    code_project_id,\n    authorization_generation,\n    job_kind,\n    state,\n    canonical_branch,\n    expected_base,\n    principal_digest,\n    lease_owner,\n    lease_acquired_at,\n    reserved_bytes,\n    cleanup_confirmed,\n    claimed_at,\n    deadline_at,\n    terminal_at,\n    result,\n    error_summary,\n    created_at,\n    updated_at;\n",
