# Public base URL reachable by the ordinary workspace runner, used to build the
# native Git gateway remote URLs. Empty/missing disables the gateway while
# normal Shell tools keep working.
# DF_GIT_PUBLIC_BASE_URL=

# Maximum proxied Git request and response body in bytes (default 268435456,
# maximum 1073741824).
# DF_GIT_GATEWAY_MAX_BODY_BYTES=

# Control-plane master key for stored Git upstream credentials: base64 for
# exactly 32 bytes, stable across restarts and across all control-plane
# replicas, never baked into an image. Absent or empty leaves the service
# running but protected credential writes and protected credential use fail
# closed with 503; a nonempty value that is not 32 base64-encoded bytes stops
# startup.
# DF_CREDENTIAL_MASTER_KEY=
